# Runtime: local port and environment (PORT optional; NODE_ENV production on deploy).
PORT=4000
NODE_ENV=development
# Required: MongoDB connection string; app and seed script read only MONGO_URI.
MONGO_URI=mongodb://127.0.0.1:27017/hrms
# Required: strong signing key for authentication tokens and optional token lifetime.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
# Required for MFA: encryption key; generate and store securely, do not rotate without a migration plan.
MFA_ENCRYPTION_KEY=replace-with-a-long-random-key
# Public-facing app/backend origins, without trailing /api/v1; used in emails, CORS and redirects.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
# Product name used in outgoing messages.
APP_NAME=HRMS
# WorkOS SSO: dashboard API key, client ID, registered callback URL, and optional default role.
WORKOS_API_KEY=replace-with-workos-api-key
WORKOS_CLIENT_ID=client_replace-me
WORKOS_REDIRECT_URI=http://localhost:4000/api/v1/auth/sso/callback
SSO_DEFAULT_ROLE=employee
# Google OAuth: app credentials, registered backend callback, and frontend redirect destination.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URI=http://localhost:3000/auth/google/callback/
# SMTP: provider host/port, login, password and sender identity.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace-with-smtp-user
EMAIL_PASS=replace-with-smtp-password
EMAIL_FROM=HRMS <no-reply@example.com>
# Cloudinary: cloud identity and API credentials for uploaded media.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-secret
# Firebase service account: project and private key metadata; use escaped \n for newlines in the key.
FIREBASE_PROJECT_ID=replace-with-project-id
FIREBASE_CLIENT_EMAIL=replace-with-service-account-email
FIREBASE_CLIENT_ID=replace-with-service-account-client-id
FIREBASE_PRIVATE_KEY_ID=replace-with-private-key-id
FIREBASE_PRIVATE_KEY=replace-with-escaped-private-key
# Gemini: active runtime reads GOOGLE_GENERATIVE_AI_API_KEY; model is optional.
GOOGLE_GENERATIVE_AI_API_KEY=replace-with-gemini-key
GEMINI_MODEL=gemini-2.0-flash
# Legacy/requested alias GEMINI_API_KEY is NOT read by current backend code.
# GEMINI_API_KEY=use-GOOGLE_GENERATIVE_AI_API_KEY-instead
# Biometric configuration encryption; preserve existing key for encrypted records.
BIOMETRIC_ENCRYPTION_KEY=replace-with-long-random-key
# Bootstrap super-admin identity and password; never keep default values in production.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-strong-password
# Optional allowlist of source IPs for super-admin endpoints (check deployment proxy configuration).
SUPER_ADMIN_ALLOWED_IPS=
# VERCEL is set by Vercel automatically; it disables local node-cron schedules.
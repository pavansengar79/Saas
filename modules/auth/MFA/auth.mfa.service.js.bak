const speakeasy = require("speakeasy");
const qrcode    = require("qrcode");
const crypto    = require("crypto");
const bcrypt    = require("bcryptjs");
const User      = require("../models/user.model");
const jwt       = require("../../../utils/jwt.utils");
const AppError  = require("../../../utils/appError");
const { encrypt, decrypt } = require("../../../utils/crypto");

// App name — shown in the QR code ("BenoSupport HRMS" in Google Authenticator)
const APP_NAME = process.env.APP_NAME || "BenoSupport HRMS";

// ─────────────────────────────────────────────────────────────────────────────
// STEP 1 — ENROL (Generate secret + QR code)
// POST /api/v1/auth/mfa/enrol
// ─────────────────────────────────────────────────────────────────────────────
//
// What happens:
//   1. Generate a new TOTP secret (speakeasy)
//   2. Create an otpauth:// URI — Google Authenticator scans this
//   3. Create a QR code image (base64 PNG)
//   4. Store the secret temporarily for the user
//      (it is saved permanently in the DB only after verification)
//
// Why store it temporarily?
//   If the user leaves without scanning the QR code, the secret is not saved permanently.
//   The actual mfaSecret is set only after verification.
// ─────────────────────────────────────────────────────────────────────────────

exports.enrol = async (userId) => {

  const user = await User.findById(userId).select("+mfaSecret +mfaTempSecret");

  if (!user) throw new AppError("User not found", 404);

  // Block if already enabled
  if (user.mfaEnabled) {
    throw new AppError(
      "MFA is already enabled. Disable it first to re-enrol.",
      400
    );
  }

  // Step 1: Generate the secret
  const secret = speakeasy.generateSecret({
    name:   `${APP_NAME} (${user.email})`,  // Label in the QR code
    length: 20,                              // 20 bytes = strong enough
  });

  // Step 2: Save temporarily until verification (ENCRYPTED!)
  user.mfaTempSecret = encrypt(secret.base32);
  await user.save({ validateBeforeSave: false });

  // Step 3: Create a QR code from the otpauth URI
  const qrCodeDataURL = await qrcode.toDataURL(secret.otpauth_url);

  return {
    secret:      secret.base32,       // For manual entry (if the QR code cannot be scanned)
    otpauthUrl:  secret.otpauth_url,  // For advanced users
    qrCode:      qrCodeDataURL,       // Use <img src={qrCode} /> in the frontend
  };

};

// ─────────────────────────────────────────────────────────────────────────────
// STEP 2 — VERIFY ENROLMENT (Confirm + activate MFA)
// POST /api/v1/auth/mfa/verify-enrolment
// ─────────────────────────────────────────────────────────────────────────────
//
// The user scanned the QR code and received a 6-digit OTP from the app — verify it
// If valid:
//   - mfaTempSecret → mfaSecret (permanent)
//   - mfaEnabled: true
//   - Generate 8 backup codes (store hashes, return plaintext)
// ─────────────────────────────────────────────────────────────────────────────

exports.verifyEnrolment = async (userId, token) => {

  const user = await User.findById(userId).select(
    "+mfaSecret +mfaTempSecret +mfaBackupCodes"
  );

  if (!user) throw new AppError("User not found", 404);

  if (user.mfaEnabled) {
    throw new AppError("MFA is already enabled", 400);
  }

  if (!user.mfaTempSecret) {
    throw new AppError(
      "No MFA enrolment in progress. Please call /mfa/enrol first.",
      400
    );
  }

  // Decrypt temp secret
  const tempSecret = decrypt(user.mfaTempSecret);

  // Verify the token against the temporary secret
  const isValid = speakeasy.totp.verify({
    secret:   tempSecret,
    encoding: "base32",
    token:    token,
    window:   1,  // ±1 time window (allows 30s drift) — prevents clock skew issues
  });

  if (!isValid) {
    throw new AppError("Invalid OTP. Please try again.", 400);
  }
await Promise.all(plainBackupCodes.map(async c => ({
    codeHash: await bcrypt.hash(c, 10),
    used: false
  })));

  user.mfaSecret      = encrypt(tempSecret);   // encrypt permanent secret
  user.mfaTempSecret  = null;                  // Clear the temporary secret
  user.mfaEnabled     = true;
  user.mfaEnrolledAt  = new Date()
  user.mfaSecret      = user.mfaTempSecret;   // temp → permanent
  user.mfaTempSecret  = null;                  // Clear the temporary secret
  user.mfaEnabled     = true;
  user.mfaBackupCodes = hashedBackupCodes;

  await user.save({ validateBeforeSave: false });

  return {
    message:     "MFA enabled successfully",
    backupCodes: plainBackupCodes,  // Show only once — the user should save them
  };

};

// ─────────────────────────────────────────────────────────────────────────────
// LOGIN CHALLENGE — Verify OTP at login
// POST /api/v1/auth/mfa/challenge
// ─────────────────────────────────────────────────────────────────────────────
//
// After login, when mfaRequired: true is returned
// The frontend requests an OTP; it is verified here → a full JWT is issued
//
// Also accepts a backup code (if the phone is unavailable)
// ─────────────────────────────────────────────────────────────────────────────

exports.verifyLoginChallenge = async (userId, token) => {

  const user = await User.findById(userId).select(
    "+mfaSecret +mfaBackupCodes"
  );

  if (!user) throw new AppError("User not found", 404);

  if (!user.mfaEnabled || !user.mfaSecret) {
    throw new AppError("MFA is not enabled for this user", 400);
  }

  // Decrypt secret for verification
  const secret = decrypt(user.mfaSecret);

  // Check TOTP first
  const isTotpValid = speakeasy.totp.verify({
    secret:   secret,
    encoding: "base32",
    token:    token,
    window:   1,
  });

  if (isTotpValid) return { verified: true, method: "totp" };

  // If TOTP fails, check the backup code
  const validBackupCode = user.mfaBackupCodes.find(async bc => 
    !bc.used && await bcrypt.compare(token, bc.codeHash)
  );

  if (validBackupCode) {
    // Mark the backup code as used after use — one-time use
    validBackupCode.used = true;
    validBackupCode.usedAt = new Date();
    await user.save({ validateBeforeSave: false });

  const remainingBackups = user.mfaBackupCodes.filter(bc => !bc.used).length;

    return {
      verified:          true,
      method:            "backup_code",
      remainingBackups:  remainingBackups,
    };
  }

  throw new AppError("Invalid OTP or backup code", 400);

};

